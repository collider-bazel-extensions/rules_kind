module(
    name = "rules_kind",
    version = "0.2.0",
)

bazel_dep(name = "bazel_skylib", version = "1.5.0")
bazel_dep(name = "platforms", version = "0.0.9")

# Bazel 8+ no longer implicitly loads legacy native rules like `sh_test` —
# tests/BUILD.bazel needs them. Dev-only since the rule library itself doesn't
# emit shell rules; consumers don't inherit this.
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

kind = use_extension("//:extensions.bzl", "kind")
kind.system(versions = ["1.29", "1.32"])
# 1.35-1.37 use the pinned kind v0.33.0 downloads: their kindest/node images
# are built for that kind release, so a host kind of another version is not a
# safe stand-in. A consumer's own kind.version()/kind.system() for the same
# minor takes precedence (root module first).
kind.version(versions = ["1.35", "1.36", "1.37"])
use_repo(kind,
    "kind_1_29_linux_amd64",
    "kind_1_29_darwin_arm64",
    "kind_1_29_darwin_amd64",
    "kind_1_32_linux_amd64",
    "kind_1_32_darwin_arm64",
    "kind_1_32_darwin_amd64",
    "kind_1_35_linux_amd64",
    "kind_1_35_darwin_arm64",
    "kind_1_35_darwin_amd64",
    "kind_1_36_linux_amd64",
    "kind_1_36_darwin_arm64",
    "kind_1_36_darwin_amd64",
    "kind_1_37_linux_amd64",
    "kind_1_37_darwin_arm64",
    "kind_1_37_darwin_amd64",
)
