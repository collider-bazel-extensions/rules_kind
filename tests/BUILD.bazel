# Failure modes, on one cluster: kube_bench_expect_fail_test.sh starts it and
# runs these kube_bench_tests (they find its env file and use it):
#   pass      kind_ignore.yaml plus an entry for a check that passes: passes,
#             listing the stale entry
#   unlisted  without the 1.2.15 entry: fails, naming 1.2.15
#   expired   1.2.15 expired 2020-01-01: fails, naming the entry
#   stale     the stale entry with fail_on_stale = True: fails
kind_cluster(
    name        = "kube_bench_fail_cluster",
    k8s_version = "1.35",
    images      = ["//:kube_bench_image"],
    tags        = ["manual", "no-sandbox", "requires-docker"],
)

genrule(
    name = "kube_bench_ignore_variants",
    srcs = ["kube_bench/kind_ignore.yaml"],
    outs = [
        "kube_bench/stale_ignore.yaml",
        "kube_bench/unlisted_ignore.yaml",
        "kube_bench/expired_ignore.yaml",
    ],
    cmd = """
        {
            cat $<
            echo '  - id: "1.1.1"'
            echo '    reason: stale on purpose (1.1.1 passes on kind)'
        } > $(location kube_bench/stale_ignore.yaml)
        awk '/^  - id:/ {skip = ($$0 ~ /"1[.]2[.]15"/)} !skip' $< > $(location kube_bench/unlisted_ignore.yaml)
        awk '{print} /^  - id: "1[.]2[.]15"$$/ {print "    expires: 2020-01-01"}' $< > $(location kube_bench/expired_ignore.yaml)
        grep -q '"1.2.15"' $(location kube_bench/unlisted_ignore.yaml) && exit 1
        grep -q 'expires: 2020-01-01' $(location kube_bench/expired_ignore.yaml)
    """,
)

[
    kube_bench_test(
        name          = "kube_bench_" + variant,
        cluster       = ":kube_bench_fail_cluster",
        ignore        = "kube_bench/{}_ignore.yaml".format(ignore),
        fail_on_stale = variant == "stale",
        tags          = ["manual"],
    )
    for variant, ignore in [
        ("pass", "stale"),
        ("unlisted", "unlisted"),
        ("expired", "expired"),
        ("stale", "stale"),
    ]
]

sh_test(
    name    = "kube_bench_expect_fail_test",
    srcs    = ["kube_bench_expect_fail_test.sh"],
    data    = [
        ":kube_bench_expired",
        ":kube_bench_fail_cluster",
        ":kube_bench_pass",
        ":kube_bench_stale",
        ":kube_bench_unlisted",
    ],
    size    = "large",
    timeout = "long",
    tags    = ["manual", "no-sandbox", "requires-docker"],
)

