load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//:defs.bzl", "kind_cluster", "kind_health_check")

# ---------------------------------------------------------------------------
# kind_cluster service for all Docker-requiring tests
# ---------------------------------------------------------------------------

kind_cluster(
    name        = "test_cluster",
    k8s_version = "1.29",
    # Preload busybox:stable into the cluster at boot via
    # `kind load image-archive`. cluster_test.sh schedules a pod
    # against `busybox:stable` with --image-pull-policy=Never, so it
    # uses the preloaded copy — no runtime registry pull, which
    # avoids rootless-podman's slirp4netns DNS resolution failure
    # to registry-1.docker.io. See #5 + DESIGN.md "Vendored test
    # images".
    images      = ["//tests/testdata:busybox.tar"],
    tags        = ["manual", "no-sandbox", "requires-docker"],
)

kind_health_check(
    name    = "test_cluster_health",
    cluster = ":test_cluster",
)

# ---------------------------------------------------------------------------
# kind_cluster with manifests applied
# ---------------------------------------------------------------------------

kind_cluster(
    name      = "test_cluster_with_manifests",
    k8s_version = "1.29",
    manifests = glob(["manifests/*.yaml"]),
    # hello_server.yaml schedules a busybox:stable pod with
    # imagePullPolicy: Never. Preload the image so rootless-podman
    # CI doesn't hit the registry DNS failure. See #5/#6.
    images    = ["//tests/testdata:busybox.tar"],
    tags      = ["manual", "no-sandbox", "requires-docker"],
)

kind_health_check(
    name    = "test_cluster_with_manifests_health",
    cluster = ":test_cluster_with_manifests",
)

# ---------------------------------------------------------------------------
# kind_health_check_test — no Docker required
# ---------------------------------------------------------------------------
# Tests that the health check exits non-zero without the env file,
# and exits 0 when the env file is present.

sh_test(
    name = "kind_health_check_test",
    srcs = ["kind_health_check_test.sh"],
    data = [":test_cluster_health"],
    tags = ["no-sandbox"],
)

# ---------------------------------------------------------------------------
# kind_server_test — requires Docker
# Tests: kind_cluster starts, writes env file, env vars present, SIGTERM shuts down.
# ---------------------------------------------------------------------------

sh_test(
    name    = "kind_server_test",
    srcs    = ["kind_server_test.sh"],
    data    = [":test_cluster"],
    size    = "large",
    timeout = "long",
    tags    = ["manual", "no-sandbox", "requires-docker"],
)

# ---------------------------------------------------------------------------
# cluster_cleanup_test — requires Docker
# Tests: cluster deleted after launcher SIGKILL or parent exit (#9);
# RULES_KIND_KEEP_CLUSTER=1 keeps it.
# ---------------------------------------------------------------------------

sh_test(
    name    = "cluster_cleanup_test",
    srcs    = ["cluster_cleanup_test.sh"],
    data    = [":test_cluster"],
    size    = "large",
    timeout = "long",
    tags    = ["manual", "no-sandbox", "requires-docker"],
)

# ---------------------------------------------------------------------------
# reaper_outlives_test — requires Docker
# Tests: the launcher is SIGKILLed and the test exits at once; the reaper
# must survive Bazel killing the test's leftover processes. CI's "No kind
# clusters left behind" step checks that the cluster is deleted.
# ---------------------------------------------------------------------------

sh_test(
    name    = "reaper_outlives_test",
    srcs    = ["reaper_outlives_test.sh"],
    data    = [":test_cluster"],
    size    = "large",
    timeout = "long",
    tags    = ["manual", "no-sandbox", "requires-docker"],
)

# ---------------------------------------------------------------------------
# cluster_test — requires Docker
# Tests: cluster connectivity, pod scheduling.
# ---------------------------------------------------------------------------

sh_test(
    name    = "cluster_test",
    srcs    = ["cluster_test.sh"],
    data    = [":test_cluster"],
    size    = "large",
    timeout = "long",
    tags    = ["manual", "no-sandbox", "requires-docker"],
)

# ---------------------------------------------------------------------------
# manifest_test — requires Docker
# Tests: manifests applied before env file written.
# ---------------------------------------------------------------------------

sh_test(
    name    = "manifest_test",
    srcs    = ["manifest_test.sh"],
    data    = [":test_cluster_with_manifests"],
    size    = "large",
    timeout = "long",
    tags    = ["manual", "no-sandbox", "requires-docker"],
)

# ---------------------------------------------------------------------------
# pod_to_pod_test — requires Docker
# kind_cluster with a pre-deployed HTTP server (hello-server pod + Service).
# Tests: pod scheduling, cluster DNS, pod-to-pod HTTP communication.
# ---------------------------------------------------------------------------

kind_cluster(
    name      = "test_cluster_pod_to_pod",
    k8s_version = "1.29",
    manifests = ["manifests/hello_server.yaml"],
    # Server pod + the test's `kubectl run` client pod both use
    # busybox:stable with imagePullPolicy: Never. Preload so
    # rootless-podman CI skips the registry pull. See #5/#6.
    images    = ["//tests/testdata:busybox.tar"],
    tags      = ["manual", "no-sandbox", "requires-docker"],
)

kind_health_check(
    name    = "test_cluster_pod_to_pod_health",
    cluster = ":test_cluster_pod_to_pod",
)

sh_test(
    name    = "pod_to_pod_test",
    srcs    = ["pod_to_pod_test.sh"],
    data    = [":test_cluster_pod_to_pod"],
    size    = "large",
    timeout = "long",
    tags    = ["manual", "no-sandbox", "requires-docker"],
)

# ---------------------------------------------------------------------------
# k8s 1.32 — analysis-time only. Confirms the macro picks the 1.32
# kind+kubectl pair (kind v0.27.0 / kubectl 1.32.2) and that the kindest
# /node:v1.32.2 pin resolves. Marked manual; consumers exercise it via their
# own smoke tests (e.g. rules_cilium).
# ---------------------------------------------------------------------------

kind_cluster(
    name        = "test_cluster_1_32",
    k8s_version = "1.32",
    tags        = ["manual", "no-sandbox", "requires-docker"],
)

kind_health_check(
    name    = "test_cluster_1_32_health",
    cluster = ":test_cluster_1_32",
)

# ---------------------------------------------------------------------------
# k8s 1.35 / 1.36 / 1.37 — boot a cluster per supported minor (kind v0.33.0,
# hermetic kind.version() binaries) and check the API server's gitVersion
# matches the digest-pinned kindest/node image and kubectl matches the minor.
# ---------------------------------------------------------------------------

[
    kind_cluster(
        name        = "test_cluster_" + minor.replace(".", "_"),
        k8s_version = minor,
        tags        = ["manual", "no-sandbox", "requires-docker"],
    )
    for minor in ["1.35", "1.36", "1.37"]
]

[
    sh_test(
        name    = "k8s_{}_version_test".format(minor.replace(".", "_")),
        srcs    = ["k8s_version_test.sh"],
        args    = ["test_cluster_" + minor.replace(".", "_"), server],
        data    = [":test_cluster_" + minor.replace(".", "_")],
        size    = "large",
        timeout = "long",
        tags    = ["manual", "no-sandbox", "requires-docker"],
    )
    for minor, server in [
        ("1.35", "v1.35.8"),
        ("1.36", "v1.36.4"),
        ("1.37", "v1.37.0"),
    ]
]

# ---------------------------------------------------------------------------
# checksums_test — no Docker, no network.
# Fails if any _KIND_VERSIONS entry carries an empty or malformed SHA-256.
# Regenerate the pins with tools/update_checksums.sh.
# ---------------------------------------------------------------------------

sh_test(
    name = "checksums_test",
    srcs = ["checksums_test.sh"],
    data = ["//:extensions.bzl"],
)
