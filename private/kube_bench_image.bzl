"""Repository rule: the digest-pinned kube-bench image as a docker-archive.

rules_kind fetches the image itself rather than through rules_oci's
`oci.pull`, so consumers of kube_bench_test don't need rules_oci (see
DESIGN.md, "kube-bench image"). Every download is by digest and checked
against it: the multi-arch index (KUBE_BENCH["index_digest"]), the platform's
image manifest (which must be the one the index lists and the one pinned in
KUBE_BENCH["manifests"]), then its config and layers. Bazel's repository
cache keeps the blobs, so a re-fetch needs no network.
"""

load(":kube_bench_versions.bzl", "KUBE_BENCH", "KUBE_BENCH_IMAGE_REF", "KUBE_BENCH_REGISTRIES")

_INDEX_TYPES = ",".join([
    "application/vnd.oci.image.index.v1+json",
    "application/vnd.docker.distribution.manifest.list.v2+json",
])

_MANIFEST_TYPES = ",".join([
    "application/vnd.oci.image.manifest.v1+json",
    "application/vnd.docker.distribution.manifest.v2+json",
])

_BUILD = """\
# Generated by rules_kind (private/kube_bench_image.bzl).
# kube-bench {version} ({platform}), {ref}
# index {index}
# manifest {manifest}
exports_files(["image.tar"], visibility = ["//visibility:public"])
"""

def _docker_hub_token(rctx, repository):
    rctx.download(
        url = "https://auth.docker.io/token?service=registry.docker.io&scope=repository:{}:pull".format(repository),
        output = "_token.json",
    )
    token = json.decode(rctx.read("_token.json"))["token"]
    rctx.delete("_token.json")
    return token

def _fetch(rctx, state, endpoint, digest, output, accept = None):
    """Downloads <registry>/v2/<repo>/<endpoint>/<digest>, verified against digest."""
    repository = rctx.attr.repository
    sha256 = digest[len("sha256:"):]
    headers = {"Accept": [accept]} if accept else {}
    errors = []
    for registry in rctx.attr.registries:
        url = "https://{}/v2/{}/{}/{}".format(registry, repository, endpoint, digest)
        auth = {}
        if registry == "registry-1.docker.io":
            if "token" not in state:
                state["token"] = _docker_hub_token(rctx, repository)
            auth = {url: {"type": "pattern", "pattern": "Bearer <password>", "password": state["token"]}}
        result = rctx.download(
            url = url,
            output = output,
            sha256 = sha256,
            headers = headers,
            auth = auth,
            allow_fail = True,
        )
        if result.success:
            return
        errors.append(url)
    fail("kube-bench image: could not download {} {} from any of: {}".format(
        endpoint[:-1], digest, ", ".join(errors)))

def _kube_bench_image_repo_impl(rctx):
    platform = rctx.attr.platform
    want_os, want_arch = platform.split("_")
    state = {}

    _fetch(rctx, state, "manifests", rctx.attr.index_digest, "_index.json", _INDEX_TYPES)
    index = json.decode(rctx.read("_index.json"))
    listed = [
        m["digest"]
        for m in index.get("manifests", [])
        if m.get("platform", {}).get("os") == want_os and
           m.get("platform", {}).get("architecture") == want_arch and
           not m.get("platform", {}).get("variant")
    ]
    if listed != [rctx.attr.manifest_digest]:
        fail(("kube-bench image: index {} lists {} for {}, but rules_kind pins {}. " +
              "Re-pin with tools/update_kube_bench.sh.").format(
            rctx.attr.index_digest,
            listed,
            platform,
            rctx.attr.manifest_digest,
        ))

    _fetch(rctx, state, "manifests", rctx.attr.manifest_digest, "_manifest.json", _MANIFEST_TYPES)
    manifest = json.decode(rctx.read("_manifest.json"))
    blobs = [manifest["config"]["digest"]] + [layer["digest"] for layer in manifest["layers"]]
    for digest in blobs:
        _fetch(rctx, state, "blobs", digest, "_blobs/" + digest[len("sha256:"):])

    python = rctx.which("python3")
    if not python:
        fail("kube-bench image: python3 not found on PATH (rules_kind needs python3 3.8+)")
    result = rctx.execute([
        python,
        rctx.path(Label("//private:docker_archive.py")),
        "image.tar",
        rctx.attr.repo_tag,
        "_manifest.json",
        "_blobs",
    ])
    if result.return_code != 0:
        fail("kube-bench image: building the docker-archive failed:\n" + result.stdout + result.stderr)
    rctx.delete("_blobs")
    rctx.delete("_index.json")
    rctx.delete("_manifest.json")

    rctx.file("BUILD.bazel", _BUILD.format(
        version = KUBE_BENCH["version"],
        platform = platform,
        ref = rctx.attr.repo_tag,
        index = rctx.attr.index_digest,
        manifest = rctx.attr.manifest_digest,
    ))

kube_bench_image_repo = repository_rule(
    implementation = _kube_bench_image_repo_impl,
    doc = "The digest-pinned kube-bench image for one platform, as a docker-archive (image.tar).",
    attrs = {
        "platform": attr.string(mandatory = True, values = ["linux_amd64", "linux_arm64"]),
        "repository": attr.string(default = KUBE_BENCH["repository"]),
        "index_digest": attr.string(default = KUBE_BENCH["index_digest"]),
        "manifest_digest": attr.string(mandatory = True),
        "repo_tag": attr.string(default = KUBE_BENCH_IMAGE_REF),
        "registries": attr.string_list(default = KUBE_BENCH_REGISTRIES),
    },
)

def kube_bench_image_repos():
    """Declares kube_bench_image_<platform> for each pinned platform."""
    for platform, digest in KUBE_BENCH["manifests"].items():
        kube_bench_image_repo(
            name = "kube_bench_image_" + platform,
            platform = platform,
            manifest_digest = digest,
        )
